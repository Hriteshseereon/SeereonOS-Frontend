# Copy to .env.local (never committed) for local development, or pass at build time.
#
# Absolute base URL of the SeereonOS API, including /api/v1. Baked into the bundle by `npm run build`.
# Leave unset (or empty) when the API serves this build itself, or a reverse proxy routes /api/* on the
# same origin to it: the app then calls /api/v1 on its own origin.
#
# The API's CORS_ORIGINS must list the origin this frontend is served from (e.g. https://app.example.com),
# unless both share one origin.
#
# Local development (API on :8000 with CORS_ORIGINS=http://localhost:5173):
VITE_API_BASE_URL=http://localhost:8000/api/v1
